# LangSmith (tracing + observability) — canonical names as of langsmith@0.10.7
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=deep-agents-phase
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy aliases still work: LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT

# OpenAI (primary model since T-DA-04 — DDR-012)
# NEVER put this in a VITE_* var — it would be baked into the JS bundle (threat 3, T-FS-00)
OPENAI_API_KEY=sk-...

# Per-thread cost budget for LangGraph Server (T-FS-01) — USD
# Default 0.10 ≈ 133K input tokens or 22K output tokens at DDR-012 rates
THREAD_BUDGET_USD=0.10

# LangGraph Server auth token (T-FS-01 / DDR-016) — leave unset to allow all (local dev bypass)
AUTH_TOKEN=changeme-dev

# Frontend auth token — must match AUTH_TOKEN above.
# Set this in apps/web/.env.local (never commit real tokens).
# VITE_AUTH_TOKEN=changeme-dev

# Google Gemini (used for T-DA-01 through T-DA-03; superseded by OpenAI in T-DA-04 — DDR-012)
GEMINI_API_KEY=AIza...

# Groq (single-call roles: LLM judge, summarisation — never in multi-turn tool-calling loops)
GROQ_API_KEY=gsk_...

# Tavily (web search tool)
TAVILY_API_KEY=tvly-...

# LLM Guard sidecar — docker compose --profile guardrails up
# Set true to route requests through the guard at localhost:8000
GUARDRAIL_ENABLED=false

# Production Docker / self-hosted (T-FS-03)
# These are injected at container runtime — never baked into the image.
# In docker-compose.yml, POSTGRES_URI and REDIS_URI are set automatically via
# the internal service hostnames. Set them here only when using external managed DB/Redis.
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
REDIS_URI=redis://localhost:6379

# Production CORS origin — set to your deployed frontend URL.
# Overrides the localhost origins baked into the Dockerfile at build time.
LANGGRAPH_ALLOW_ORIGIN=https://your-app.example.com
