# LangSmith (tracing + observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=deep-agents-phase
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Google Gemini (primary model — use alias for exploration, pin version for experiments)
GEMINI_API_KEY=AIza...

# Groq (single-call roles: LLM judge, summarisation — never in multi-turn tool-calling loops)
GROQ_API_KEY=gsk_...

# Tavily (web search tool)
TAVILY_API_KEY=tvly-...

# LLM Guard sidecar — docker compose --profile guardrails up
# Set true to route requests through the guard at localhost:8000
GUARDRAIL_ENABLED=false
