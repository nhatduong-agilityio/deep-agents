{
  "name": "generative-ai",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter web test",
    "dev:web": "pnpm --filter web dev",
    "test:integration": "node --env-file=.env node_modules/vitest/dist/cli.js run --config vitest.integration.config.ts --reporter=verbose",
    "diagrams": "node scripts/render-diagrams.mjs",
    "dev:server": "langgraphjs dev",
    "dump-tools": "tsx --env-file=.env scripts/dump-tools.ts",
    "smoke-server": "tsx --env-file=.env scripts/smoke-server.ts",
    "smoke-permissions": "tsx --env-file=.env scripts/smoke-permissions.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/google-genai": "2.3.2",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-api": "1.5.1",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-sdk": "1.12.0",
    "@langchain/openai": "1.6.2",
    "deepagents": "1.14.1",
    "langchain": "1.5.15",
    "langsmith": "0.10.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@langchain/langgraph-cli": "1.5.1",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@types/node": "26.6.4",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
