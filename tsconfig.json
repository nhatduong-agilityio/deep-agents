{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@deep-agents/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["experiments/**/*", "packages/core/src/**/*", "scripts/**/*", "benchmark/**/*"],
  "exclude": ["node_modules", "dist", "apps/**/*"]
}
